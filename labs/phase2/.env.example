# Copy to .env if you run Compose with --env-file. Compose already injects
# these for the local lab. Never put real credentials here.

LAB_ENV=lab
LAB_FAULTS=0
LAB_FAULT_DELAY_MS=0
LAB_FAULT_POSTGRES=0
LAB_FAULT_REDIS=0
LAB_FAULT_WORKER=0
LAB_FAULT_EXTERNAL=0

POSTGRES_USER=lab
POSTGRES_PASSWORD=lab
POSTGRES_DB=rails_lab
POSTGRES_QUEUE_DB=rails_queue_lab
DATABASE_URL=postgresql://lab:lab@postgres:5432/fastapi_lab
RAILS_DATABASE_URL=postgresql://lab:lab@postgres:5432/rails_lab
QUEUE_DATABASE_URL=postgresql://lab:lab@postgres:5432/rails_queue_lab
REDIS_URL=redis://redis:6379/0

# Dummy secret for the lab container. Generate your own outside this repo.
SECRET_KEY_BASE=lab-dev-secret-not-for-production
RAILS_ENV=production
SOLID_QUEUE_IN_PUMA=true

# Optional local OTLP export. Leave empty to keep instrumentation disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_SERVICE_NAME=url-shortener-local
